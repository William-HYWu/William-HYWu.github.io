{% assign institution_heading = include.heading_level | default: 3 %}
{% assign role_heading = institution_heading | plus: 1 %}
<ol class="research-timeline">
  <li class="timeline-entry">
    <p class="timeline-date">Jan 2026 – Present</p>
    <section class="timeline-content" aria-labelledby="princeton-title">
      <h{{ institution_heading }} class="experience-institution" id="princeton-title">Princeton University</h{{ institution_heading }}>
      <h{{ role_heading }} class="experience-role">Research Intern · Z Lab</h{{ role_heading }}>
      <p class="experience-advisors">With <a href="https://liuzhuang13.github.io">Prof. Zhuang Liu</a> and <a href="https://www.cs.princeton.edu/~danqic/">Prof. Danqi Chen</a></p>
      <a class="experience-project" href="{{ '/publications/#sarch2026vero' | relative_url }}">Vero: general visual reasoning →</a>
    </section>
  </li>

  <li class="timeline-entry">
    <p class="timeline-date">Sep 2025 – Present</p>
    <section class="timeline-content" aria-labelledby="michigan-title">
      <h{{ institution_heading }} class="experience-institution" id="michigan-title">University of Michigan</h{{ institution_heading }}>
      <h{{ role_heading }} class="experience-role">Research Intern · <a href="https://arm.robotics.umich.edu">ARM Lab</a></h{{ role_heading }}>
      <p class="experience-advisors">Advised by <a href="https://berenson.robotics.umich.edu">Prof. Dmitry Berenson</a></p>
      <a class="experience-project" href="{{ '/publications/#wu2027topology' | relative_url }}">Topology-informed visual prompting →</a>
    </section>
  </li>

  <li class="timeline-entry">
    <p class="timeline-date">Jan 2024 – Sep 2025</p>
    <section class="timeline-content" aria-labelledby="sjtu-title">
      <h{{ institution_heading }} class="experience-institution" id="sjtu-title">Shanghai Jiao Tong University</h{{ institution_heading }}>
      <h{{ role_heading }} class="experience-role">Research Intern · <a href="https://banyutong.github.io/sirius_lab_website/">SIRIUS Lab</a></h{{ role_heading }}>
      <p class="experience-advisors">Mentored by <a href="https://people.csail.mit.edu/yban/">Prof. Yutong Ban</a></p>
      <a class="experience-project" href="{{ '/publications/#wu2025hidssm' | relative_url }}">Hierarchical state space models for surgical videos →</a>
    </section>
  </li>
</ol>
