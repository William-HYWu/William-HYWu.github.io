@article{wu2027topology,
  abbr       = {ICRA},
  title      = {Topology-Informed Visual Prompting for Vision-Language-Action Policies},
  author     = {Wu, Haoyang and Kumar, Abhinav and Berenson, Dmitry},
  journal    = {In submission to IEEE International Conference on Robotics and Automation},
  year       = {2027},
  arxiv      = {2609.23944},
  pdf        = {https://arxiv.org/pdf/2609.23944},
  website    = {https://topology-vla.github.io},
  preview    = {tivp.jpeg},
  abstract   = {We use simulated planning and topological reasoning to generate additional training trajectories, then visually prompt vision-language-action policies with predicted robot waypoints during deployment. The method improves performance across simulated and real-world tasks, increasing hardware success by 40 percent over the strongest baseline.},
  selected   = {true}
}

@inproceedings{sarch2026vero,
  abbr       = {ECCV},
  title      = {Vero: An Open RL Recipe for General Visual Reasoning},
  author     = {Sarch, Gabriel and Cai, Linrong and Wang, Qunzhong and Wu, Haoyang and Chen, Danqi and Liu, Zhuang},
  booktitle  = {European Conference on Computer Vision},
  year       = {2026},
  arxiv      = {2604.04917},
  pdf        = {https://arxiv.org/abs/2604.04917},
  website    = {https://vero-reasoning.github.io},
  preview    = {vero.png},
  abstract   = {Vero is a family of fully open vision-language models for general visual reasoning. By scaling reinforcement-learning data with the 600K-sample Vero-600K dataset and task-routed rewards, Vero achieves state-of-the-art performance across 30 challenging benchmarks.},
  selected   = {true}
}

@article{wu2025hidssm,
  abbr       = {TMI},
  title      = {Holistic Surgical Phase Recognition with Hierarchical Input-Dependent State Space Models},
  author     = {Wu, Haoyang and Wang, Tsun-Hsuan and Lechner, Mathias and Hasani, Ramin and Eckhoff, Jennifer A. and Pak, Paul and Meireles, Ozanan R. and Rosman, Guy and Ban, Yutong and Rus, Daniela},
  journal    = {In submission to IEEE Transactions on Medical Imaging},
  year       = {2025},
  arxiv      = {2506.21330},
  pdf        = {https://arxiv.org/abs/2506.21330},
  website    = {https://william-hywu.github.io/HID-SSM/},
  preview    = {hid-ssm.png},
  abstract   = {We propose a hierarchical input-dependent state space model for decision-making over full-length surgical videos. The framework combines a temporally consistent visual encoder with local aggregation and global relation modules for fine-grained dynamics and long-range dependencies.},
  selected   = {true}
}
